+fn bounded_untracked_diffs<I, F>(diffs: I) -> impl Stream<Item = F::Output> + Send
+where
+    I: IntoIterator<Item = F>,
+    I::IntoIter: Send,
+    F: Future + Send,
+    F::Output: Send,
+{
+    stream::iter(diffs)
+        .map(|diff| async move {
+            // Remote requests may overlap, so share the limit across requests and
+            // acquire it before polling the future that spawns the Git process.
+            let _permit = UNTRACKED_DIFF_SEMAPHORE
+                .acquire()
+                .await
+                .unwrap_or_else(|_| unreachable!("untracked diff semaphore is never closed"));
+            diff.await
+        })
+        // Preserve the file listing order without retaining every completed diff.
+        .buffered(MAX_CONCURRENT_UNTRACKED_DIFFS)
+}
