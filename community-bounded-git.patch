@@ -0,0 +1,136 @@
+use super::*;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::task::Poll;
+
+use pretty_assertions::assert_eq;
+
+static TEST_SEMAPHORE: Semaphore = Semaphore::const_new(1);
+
+#[test]
+fn untracked_diff_request_future_is_send() {
+    fn assert_request_future_is_send(cwd: &Path) {
+        fn assert_send(_: impl Future + Send) {}
+        assert_send(git_diff_to_remote(cwd));
+    }
+
+    // Construct and drop the real request future without polling or spawning Git.
+    assert_request_future_is_send(Path::new("."));
+}
+
+struct ActiveDiff(Arc<AtomicUsize>);
+
+impl Drop for ActiveDiff {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+#[tokio::test]
+async fn untracked_diffs_bound_overlapping_requests_and_preserve_all_results() {
+    let _test_guard = TEST_SEMAPHORE.acquire().await.expect("serialize tests");
+    let active = Arc::new(AtomicUsize::new(0));
+    let peak = Arc::new(AtomicUsize::new(0));
+    let completion_order = Arc::new(Mutex::new(Vec::new()));
+    let batch_size = 2048;
+    let batch = |start| {
+        let active = Arc::clone(&active);
+        let peak = Arc::clone(&peak);
+        let completion_order = Arc::clone(&completion_order);
+        let first_file_ready = Arc::new(tokio::sync::Notify::new());
+        bounded_untracked_diffs((start..start + batch_size).map(move |index| {
+            let active = Arc::clone(&active);
+            let peak = Arc::clone(&peak);
+            let completion_order = Arc::clone(&completion_order);
+            let first_file_ready = Arc::clone(&first_file_ready);
+            async move {
+                let current = active.fetch_add(1, Ordering::SeqCst) + 1;
+                let _active_diff = ActiveDiff(active);
+                peak.fetch_max(current, Ordering::SeqCst);
+                if index == start {
+                    first_file_ready.notified().await;
+                } else {
+                    tokio::task::yield_now().await;
+                }
+                completion_order.lock().unwrap().push(index);
+                if index == start + 1 {
+                    first_file_ready.notify_one();
+                }
+                format!("patch-{index}\n")
+            }
+        }))
+        .collect::<Vec<_>>()
+    };
+
+    let (first, second) = tokio::time::timeout(TokioDuration::from_secs(10), async {
+        tokio::join!(batch(0), batch(batch_size))
+    })
+    .await
+    .expect("bounded diff requests should complete");
+
+    assert_eq!(peak.load(Ordering::SeqCst), MAX_CONCURRENT_UNTRACKED_DIFFS);
+    assert_eq!(active.load(Ordering::SeqCst), 0);
+    let expected = |start| {
+        (start..start + batch_size)
+            .map(|index| format!("patch-{index}\n"))
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(first, expected(0));
+    assert_eq!(second, expected(batch_size));
+    let completed = completion_order.lock().unwrap();
+    assert_eq!(completed.len(), batch_size * 2);
+    assert_ne!(completed.first(), Some(&0));
+}
+
+#[tokio::test]
+async fn untracked_diffs_release_shared_permits_when_canceled() {
+    let _test_guard = TEST_SEMAPHORE.acquire().await.expect("serialize tests");
+    let active = Arc::new(AtomicUsize::new(0));
+    let mut request = Box::pin(
+        bounded_untracked_diffs((0..MAX_CONCURRENT_UNTRACKED_DIFFS * 2).map(|_| {
+            let active = Arc::clone(&active);
+            async move {
+                active.fetch_add(1, Ordering::SeqCst);
+                let _active_diff = ActiveDiff(active);
+                futures::future::pending::<usize>().await
+            }
+        }))
+        .collect::<Vec<_>>(),
+    );
+
+    tokio::time::timeout(
+        TokioDuration::from_secs(5),
+        futures::future::poll_fn(|cx| {
+            assert!(request.as_mut().poll(cx).is_pending());
+            if active.load(Ordering::SeqCst) == MAX_CONCURRENT_UNTRACKED_DIFFS {
+                Poll::Ready(())
+            } else {
+                Poll::Pending
+            }
+        }),
+    )
+    .await
+    .expect("request should acquire the shared permits");
+    assert_eq!(UNTRACKED_DIFF_SEMAPHORE.available_permits(), 0);
+
+    drop(request);
+    assert_eq!(active.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        UNTRACKED_DIFF_SEMAPHORE.available_permits(),
+        MAX_CONCURRENT_UNTRACKED_DIFFS
+    );
+
+    let results = tokio::time::timeout(
+        TokioDuration::from_secs(5),
+        bounded_untracked_diffs((0..MAX_CONCURRENT_UNTRACKED_DIFFS).map(futures::future::ready))
+            .collect::<Vec<_>>(),
+    )
+    .await
+    .expect("a subsequent request should be able to run");
+    assert_eq!(
+        results,
+        (0..MAX_CONCURRENT_UNTRACKED_DIFFS).collect::<Vec<_>>()
+    );
+}
